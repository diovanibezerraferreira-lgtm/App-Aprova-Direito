rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (used for healthchecks)
    match /test/{docId} {
      allow read: if true;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Answer Subcollection
      match /answers/{questionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(questionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(questionId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(questionId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(questionId);
      }

      // User Simulado Subcollection
      match /simulados/{simuladoId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(simuladoId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(simuladoId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(simuladoId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(simuladoId);
      }
    }
  }
}

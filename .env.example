# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# INTEGRAÇÃO ASAAS (PAGAMENTOS & ASSINATURAS - BACKEND VERCEL / SERVERLESS)
# NUNCA exponha estas chaves com prefixo VITE_ no frontend!
# ==============================================================================

# Chave secreta da API Asaas (Sandbox: $aact_YTU5... | Produção: $aact_...)
ASAAS_API_KEY=""

# Ambiente do Asaas: "sandbox" (testes sem cobrança real) ou "production"
ASAAS_ENVIRONMENT="sandbox"

# Token secreto configurado no painel de Webhooks do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=""

# ==============================================================================
# FIREBASE ADMIN SDK (BACKEND VERCEL PARA VALIDAR TOKENS E ATUALIZAR FIRESTORE)
# ==============================================================================
FIREBASE_PROJECT_ID="gen-lang-client-0793753103"
FIRESTORE_DATABASE_ID="ai-studio-aprovadireito-858e292a-4f1d-4483-a130-1a8041386c5a"

# E-mail da conta de serviço (client_email do JSON gerado no Console Firebase)
FIREBASE_CLIENT_EMAIL=""

# Chave privada da conta de serviço (private_key do JSON, mantendo \n)
FIREBASE_PRIVATE_KEY=""

# Alternativa: JSON completo da conta de serviço em uma única linha (opcional)
# FIREBASE_SERVICE_ACCOUNT_KEY=""
